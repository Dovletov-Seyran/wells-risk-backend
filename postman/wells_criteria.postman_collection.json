{
  "info": {
    "_postman_id": "51c5a33c-44f0-48f9-b6c8-81f8b9f0ee34",
    "name": "Критерии Уэллса — веб-сервис (ЛР3)",
    "description": "Коллекция из 10 запросов к веб-сервису справочника критериев шкалы Уэллса: по одному запросу на каждый метод.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET Список критериев с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/criteria?min_points=1.5",
          "host": ["{{base_url}}"],
          "path": ["criteria"],
          "query": [
            {
              "key": "min_points",
              "value": "1.5",
              "description": "минимальный вес критерия в баллах Уэллса"
            }
          ]
        },
        "description": "Опубликованные критерии Уэллса с весом не ниже заданного. Поле is_mine = 1, если критерий создан текущим врачом."
      },
      "response": []
    },
    {
      "name": "02 POST Добавление критерия с изображением и видео",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/criteria",
        "description": "Новый критерий в статусе черновик. Файлы уходят в MinIO, в БД сохраняются их ключи. Перед отправкой выбери файлы в полях image и video.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "criterion_name",
              "value": "Клинические признаки ТГВ",
              "type": "text"
            },
            {
              "key": "short_description",
              "value": "Отёк и болезненность по ходу глубоких вен голени",
              "type": "text"
            },
            {
              "key": "criterion_group",
              "value": "осмотр",
              "type": "text"
            },
            {
              "key": "wells_points",
              "value": "3",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": null
            },
            {
              "key": "video",
              "type": "file",
              "src": null
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 GET Черновик критерия",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/criteria/draft",
        "description": "Поля черновика текущего врача, ид не указывается. Черновик не может быть больше одного."
      },
      "response": []
    },
    {
      "name": "04 PUT Публикация критерия",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{base_url}}/criteria/{{criterion_id}}/publish",
        "description": "Смена статуса черновик -> опубликован, заполняется formed_at. Обратный переход не предусмотрен."
      },
      "response": []
    },
    {
      "name": "05 GET Лента критериев",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/criteria/feed",
          "host": ["{{base_url}}"],
          "path": ["criteria", "feed"],
          "query": [
            {
              "key": "criterion_id",
              "value": "{{criterion_id}}",
              "description": "ид критерия ленты",
              "disabled": true
            },
            {
              "key": "next",
              "value": "true",
              "description": "следующий критерий после указанного",
              "disabled": true
            }
          ]
        },
        "description": "Без параметров — первый критерий ленты (ид не указывается). С включёнными criterion_id и next=true — следующий критерий после указанного. Поле is_liked = 1, если текущий врач отметил критерий."
      },
      "response": []
    },
    {
      "name": "06 POST Лайк критерия",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria/{{criterion_id}}/like",
        "description": "value = 1 ставит лайк текущего врача, value = 0 отменяет его.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"value\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "07 DELETE Удаление критерия",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/criteria/{{criterion_id}}",
        "description": "Логическое удаление своего критерия, запись остаётся в БД в статусе удалён."
      },
      "response": []
    },
    {
      "name": "08 POST Регистрация врача",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/physicians/register",
        "description": "Регистрация нового врача, пароль хранится в виде sha256-хеша.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"kuznetsov\",\n    \"password\": \"secret123\",\n    \"full_name\": \"Кузнецов Андрей Николаевич\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "09 POST Аутентификация врача (заглушка)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/physicians/login",
        "description": "Заглушка для лабораторной работы №4, где метод будет выдавать JWT-токен.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"ivanov\",\n    \"password\": \"ivanov123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "10 POST Деавторизация врача (заглушка)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/physicians/logout",
        "description": "Заглушка для лабораторной работы №4, где токен будет попадать в blacklist."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "criterion_id",
      "value": "1",
      "type": "string"
    }
  ]
}
