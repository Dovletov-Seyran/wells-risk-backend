{
  "info": {
    "_postman_id": "51c5a33c-44f0-48f9-b6c8-81f8b9f0ee34",
    "name": "Критерии Уэллса — веб-сервис (ЛР4)",
    "description": "Коллекция из 10 запросов к веб-сервису справочника критериев шкалы Уэллса: по одному запросу на каждый метод. Токен из ответа аутентификации (Swagger или запрос 09) вставляется в переменную token, заголовок Authorization: Bearer {{token}} включается галочкой во вкладке Headers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Список критериев с фильтром",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{base_url}}/criteria?min_points=1.5",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "criteria"
          ],
          "query": [
            {
              "key": "min_points",
              "value": "1.5",
              "description": "минимальный вес критерия в баллах Уэллса"
            }
          ]
        },
        "description": "Опубликованные критерии с весом не ниже заданного. Работает без токена; с включённым заголовком Authorization поле is_mine = 1 у критериев текущего врача."
      },
      "response": []
    },
    {
      "name": "02 Добавление критерия с изображением и видео",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria",
        "description": "Только с токеном. Новый критерий в статусе черновик, создатель берётся из JWT. Перед отправкой выбери файлы в полях image и video.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "criterion_name",
              "value": "Клинические признаки ТГВ",
              "type": "text"
            },
            {
              "key": "short_description",
              "value": "Отёк и болезненность по ходу глубоких вен голени",
              "type": "text"
            },
            {
              "key": "criterion_group",
              "value": "осмотр",
              "type": "text"
            },
            {
              "key": "wells_points",
              "value": "3",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": null
            },
            {
              "key": "video",
              "type": "file",
              "src": null
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 Черновик критерия",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria/draft",
        "description": "Только с токеном. Черновик текущего врача, ид не указывается."
      },
      "response": []
    },
    {
      "name": "04 Публикация критерия",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria/{{criterion_id}}/publish",
        "description": "Только с токеном: без заголовка Authorization ответ 403. Смена статуса черновик -> опубликован, заполняется formed_at."
      },
      "response": []
    },
    {
      "name": "05 Лента критериев",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{base_url}}/criteria/feed",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "criteria",
            "feed"
          ],
          "query": [
            {
              "key": "criterion_id",
              "value": "{{criterion_id}}",
              "description": "ид критерия ленты",
              "disabled": true
            },
            {
              "key": "next",
              "value": "true",
              "description": "следующий критерий после указанного",
              "disabled": true
            }
          ]
        },
        "description": "Без параметров — первый критерий ленты (ид не указывается). С включёнными criterion_id и next=true — следующий после указанного. Работает без токена; с заголовком Authorization поле is_liked = 1, если текущий врач поставил лайк."
      },
      "response": []
    },
    {
      "name": "06 Лайк критерия",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria/{{criterion_id}}/like",
        "description": "Только с токеном. value = 1 ставит лайк текущего врача, value = 0 отменяет его.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"value\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "07 Удаление критерия",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/criteria/{{criterion_id}}",
        "description": "Только с токеном. Логическое удаление своего критерия, запись остаётся в БД в статусе удалён."
      },
      "response": []
    },
    {
      "name": "08 Регистрация врача",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/physicians/register",
        "description": "Регистрация нового врача, пароль хранится в виде sha1-хеша. Ответ {\"ok\": true}.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"kuznetsov\",\n    \"password\": \"secret123\",\n    \"full_name\": \"Кузнецов Андрей Николаевич\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "09 Аутентификация врача",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/physicians/login",
        "description": "Проверка логина и пароля. access_token из ответа вставь в переменную коллекции token.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"login\": \"kuznetsov\",\n    \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "10 Деавторизация врача",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/physicians/logout",
        "description": "Только с токеном. Токен попадает в blacklist Redis и дальше не принимается (403)."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:18080/api",
      "type": "string"
    },
    {
      "key": "criterion_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
